Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Enabled: false
      Topic:
        Value: /${agent_name}/particle_cloud
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL Pose
      Enabled: false
      Topic:
        Value: /${agent_name}/amcl_pose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: false
      Topic:
        Value: /map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.7
    - Class: rviz_default_plugins/GridCells
      Name: Frontiers
      Enabled: false
      Topic:
        Value: /frontiers
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 0; 220; 120
      Alpha: 1
    - Class: rviz_default_plugins/GridCells
      Name: Suggested Frontier
      Enabled: false
      Topic:
        Value: /suggested_frontier
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 255; 80; 180
      Alpha: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /${agent_name}/scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Axes: true
      Show Arrows: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /${agent_name}/robot_description
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: "${tf_prefix}"
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: ${fixed_frame}
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Single click: true
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /${agent_name}/initialpose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
