# Copy to .env and set your group's assigned values
# For direct ros2 commands, run source .env
export ROBOT_NAME=REPLACE_WITH_YOUR_ROBOT_NAME
export ROS_DOMAIN_ID=REPLACE_WITH_ASSIGNED_DOMAIN
# ROS_LOCALHOST_ONLY must be set to 0 for real-world
export ROS_LOCALHOST_ONLY=1
# Set USE_SIM_TIME=false when using a physical robot
export USE_SIM_TIME=true
